DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.quzzmucyzwzutfqlgrzq.supabase.co:5432/postgres"

PORT=5000
NODE_ENV=production
JWT_SECRET=logiflow_production_secret_key_2026_super_secure

