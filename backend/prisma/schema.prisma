generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             String   @id @default(uuid())
  name           String
  branding_logo  String?
  address        String?
  gst_number     String?
  pan_number     String?
  invoice_prefix String?
  currency       String   @default("INR")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users            User[]
  clients          Client[]
  courier_partners CourierPartner[]
  shipments        Shipment[]
  import_profiles  ImportProfile[]
  import_jobs      ImportJob[]
  rate_cards       RateCard[]
  invoices         ClientInvoice[]
  courier_bills    CourierBill[]
  audit_logs       AuditLog[]
  settings         Setting[]
  zoneMappings     ZoneMapping[]
  warehouses       Warehouse[]
  pickup_requests  PickupRequest[]
  support_tickets  SupportTicket[]
  api_logs         ApiLog[]
  courier_accounts CourierAccount[]
  courier_waybills CourierWaybill[]
}

model User {
  id                    String    @id @default(uuid())
  company_id            String
  email                 String    @unique
  password              String?
  first_name            String?
  last_name             String?
  role                  String    @default("VIEWER") // SUPER_ADMIN, ADMIN, OPERATIONS, ACCOUNTS, VIEWER, CLIENT
  client_id             String?
  reset_password_token  String?
  reset_password_expires DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  client  Client? @relation(fields: [client_id], references: [id])
}

model Client {
  id               String   @id @default(uuid())
  company_id       String
  client_id        String // Custom ID like CLI-001
  company_name     String
  contact_person   String?
  phone            String?
  email            String?
  address          String?
  gst_number       String?
  pan_number       String?
  billing_address  String?
  shipping_address String?
  payment_terms    String?
  credit_limit     Float?
  status           String   @default("ACTIVE")
  notes            String?
  agreement_document String? // Base64 string for PDF/Image
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  company          Company          @relation(fields: [company_id], references: [id])
  shipments        Shipment[]
  invoices         ClientInvoice[]
  rateCards        RateCard[]
  users            User[]
  warehouses       Warehouse[]
  pickup_requests  PickupRequest[]
  support_tickets  SupportTicket[]
}

model CourierPartner {
  id             String   @id @default(uuid())
  company_id     String
  courier_id     String // Custom ID
  courier_name   String
  contact_person String?
  phone          String?
  email          String?
  account_number String?
  billing_cycle  String?
  gst_number     String?
  status         String   @default("ACTIVE")
  notes          String?
  api_credentials     String? // JSON string containing API keys/secrets
  agreement_document  String? // Base64 string for PDF/Image
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  company         Company         @relation(fields: [company_id], references: [id])
  shipments       Shipment[]
  import_profiles ImportProfile[]
  rateCards       RateCard[]
  courier_bills   CourierBill[]
  accounts        CourierAccount[]
  courier_waybills CourierWaybill[]
}

model Shipment {
  id            String    @id @default(uuid())
  company_id    String
  awb_number    String
  client_id     String?
  courier_id    String?
  booking_date  DateTime?
  pickup_date   DateTime?
  delivery_date DateTime?

  sender_name      String?
  sender_phone     String?
  sender_address   String?
  receiver_name    String?
  receiver_phone   String?
  receiver_address String?
  city             String?
  state            String?
  pincode          String?
  origin           String?
  destination      String?

  service_type      String?
  package_type      String?
  number_of_pieces  Int?
  actual_weight     Float?
  volumetric_weight Float?
  chargeable_weight Float?

  cod_amount     Float?
  declared_value Float?

  courier_status   String? // Raw status from courier
  internal_status  String  @default("BOOKED") // Normalized status
  delivery_attempt Int     @default(0)
  rto_reason       String?
  exception_reason String?

  courier_cost  Float?
  client_charge Float? // Base freight + docket + fov
  profit        Float?
  remarks       String?

  client_reference_no String? // e.g. Inv No. from client
  green_tax_amount    Float   @default(0)
  oda_amount          Float   @default(0)
  fsc_amount          Float   @default(0)
  idc_amount          Float   @default(0)

  // --- Client Commercial Rate Snapshot (Frozen at Booking) ---
  client_base_freight  Float?   @default(0)
  client_docket_charge Float?   @default(0)
  client_fov_charge    Float?   @default(0)
  client_fsc_amount    Float?   @default(0)
  client_idc_amount    Float?   @default(0)
  client_oda_amount    Float?   @default(0)
  client_green_tax     Float?   @default(0)
  client_gst_amount    Float?   @default(0)
  client_total_charge  Float?   @default(0)

  // --- Courier Purchase Cost Snapshot (Frozen at Booking) ---
  courier_base_cost    Float?   @default(0)
  courier_docket_cost  Float?   @default(0)
  courier_fov_cost     Float?   @default(0)
  courier_fsc_cost     Float?   @default(0)
  courier_idc_cost     Float?   @default(0)
  courier_oda_cost     Float?   @default(0)
  courier_green_tax    Float?   @default(0)
  courier_gst_amount   Float?   @default(0)
  courier_total_cost   Float?   @default(0)

  // --- Financial Profit Metrics ---
  gross_margin         Float?   @default(0)
  margin_percentage    Float?   @default(0)

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  podImageUrl  String?
  podSignature String?
  deliveredAt  DateTime?
  label_url    String? // URL to the shipping label PDF from Courier

  company Company         @relation(fields: [company_id], references: [id])
  client  Client?         @relation(fields: [client_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])

  appointment_date       DateTime?
  appointment_slot       String?
  appointment_token      String?
  dock_number            String?
  appointment_status     String?   @default("NOT_REQUIRED") // NOT_REQUIRED, SCHEDULED, CONFIRMED, COMPLETED, MISSED, RESCHEDULED
  appointment_notes      String?
  po_number              String?
  po_expiry_date         DateTime?
  promised_delivery_date DateTime?

  invoice_id     String?
  invoice        ClientInvoice?          @relation(fields: [invoice_id], references: [id])
  status_history ShipmentStatusHistory[]

  @@unique([company_id, awb_number])
  @@index([awb_number])
  @@index([client_id])
  @@index([courier_id])
  @@index([internal_status])
  @@index([pincode])
}

model ShipmentStatusHistory {
  id          String   @id @default(uuid())
  shipment_id String
  status      String
  raw_status  String?
  location    String?
  timestamp   DateTime
  created_at  DateTime @default(now())

  shipment Shipment @relation(fields: [shipment_id], references: [id])
}

model ImportProfile {
  id           String   @id @default(uuid())
  company_id   String
  courier_id   String?
  name         String
  mapping_json String // JSON string of mappings
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company         @relation(fields: [company_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])
}

model ImportJob {
  id            String   @id @default(uuid())
  company_id    String
  file_name     String
  courier_id    String?
  status        String // PENDING, PROCESSING, COMPLETED, FAILED
  total_rows    Int      @default(0)
  imported_rows Int      @default(0)
  updated_rows  Int      @default(0)
  error_rows    Int      @default(0)
  created_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])
}

model RateCard {
  id         String @id @default(uuid())
  company_id String
  name       String
  type       String // CLIENT, COURIER

  min_weight_kg      Float @default(0)
  docket_charge      Float @default(0)
  min_booking_amount Float @default(0)
  volumetric_divisor Float @default(5000)
  fov_percentage     Float @default(0)
  fov_minimum        Float @default(0)

  fsc_percentage     Float @default(0)
  idc_percentage     Float @default(0)
  oda_charge         Float @default(0) // flat fee per shipment if applicable
  green_tax_rate     Float @default(0) // flat fee per shipment

  rates_matrix String @default("{}") // JSON string of origin-to-destination zones

  client_id  String?
  courier_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company         @relation(fields: [company_id], references: [id])
  client  Client?         @relation(fields: [client_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])
}

model ZoneMapping {
  id         String @id @default(uuid())
  company_id String
  state_name String
  zone_name  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, state_name])
}

model ClientInvoice {
  id             String   @id @default(uuid())
  company_id     String
  invoice_number String
  client_id      String
  invoice_date   DateTime
  due_date       DateTime
  shipment_count Int      @default(0)
  subtotal       Float    @default(0)
  total_fsc      Float    @default(0)
  total_idc      Float    @default(0)
  total_oda      Float    @default(0)
  total_green_tax Float   @default(0)
  
  off_loading_charges Float @default(0)
  vehicle_charges     Float @default(0)
  insurance_charges   Float @default(0)
  rto_charges         Float @default(0)

  taxable_amount Float    @default(0)
  cgst_amount    Float    @default(0)
  sgst_amount    Float    @default(0)
  igst_amount    Float    @default(0)
  round_off      Float    @default(0)

  discount       Float    @default(0)
  total_amount   Float    @default(0)
  paid_amount    Float    @default(0)
  status         String   @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  company   Company    @relation(fields: [company_id], references: [id])
  client    Client     @relation(fields: [client_id], references: [id])
  shipments Shipment[]
}

model CourierBill {
  id           String   @id @default(uuid())
  company_id   String
  bill_number  String
  courier_id   String
  bill_date    DateTime
  total_amount Float
  status       String   @default("SUBMITTED") // SUBMITTED, RECONCILED, DISPUTED, PAID
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company           @relation(fields: [company_id], references: [id])
  courier CourierPartner    @relation(fields: [courier_id], references: [id])
  items   CourierBillItem[]
}

model CourierBillItem {
  id                   String   @id @default(uuid())
  courier_bill_id      String
  awb_number           String
  expected_weight      Float?
  billed_weight        Float?
  weight_discrepancy   Float?
  expected_zone        String?
  billed_zone          String?
  expected_cost        Float?
  billed_cost          Float?
  cost_variance        Float?
  reconciliation_status String  @default("MATCHED") // MATCHED, WEIGHT_DISCREPANCY, ZONE_MISMATCH, OVERCHARGED, UNMATCHED_AWB
  created_at           DateTime @default(now())

  courier_bill CourierBill @relation(fields: [courier_bill_id], references: [id], onDelete: Cascade)

  @@index([courier_bill_id])
  @@index([awb_number])
}

model AuditLog {
  id          String   @id @default(uuid())
  company_id  String
  user_id     String?
  action      String
  entity_type String?
  entity_id   String?
  details     String? // JSON string
  created_at  DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])
}

model Setting {
  id         String   @id @default(uuid())
  company_id String
  key        String
  value      String // JSON string
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, key])
}

model Warehouse {
  id                    String   @id @default(uuid())
  company_id            String
  client_id             String?
  facility_name         String
  contact_person        String?
  contact_phone         String
  email                 String?
  address_line          String
  pincode               String
  city                  String
  state                 String
  default_pickup_slot   String?  @default("10:00 AM - 01:00 PM")
  working_days          String?  @default("Monday,Tuesday,Wednesday,Thursday,Friday,Saturday")
  return_same_as_pickup Boolean  @default(true)
  return_address        String?
  status                String   @default("ACTIVE")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  company         Company         @relation(fields: [company_id], references: [id])
  client          Client?         @relation(fields: [client_id], references: [id])
  pickup_requests PickupRequest[]

  @@index([company_id])
  @@index([client_id])
}

model PickupRequest {
  id              String   @id @default(uuid())
  company_id      String
  client_id       String?
  pickup_id       String   @unique
  warehouse_id    String?
  facility_name   String
  pickup_date     DateTime
  pickup_slot     String
  box_count       Int      @default(1)
  lrn_numbers     String?
  status          String   @default("Scheduled") // Scheduled, Out for Pickup, Picked, Not Picked, Cancelled
  escalated       Boolean  @default(false)
  otp_verified    Boolean  @default(false)
  executive_phone String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company   Company    @relation(fields: [company_id], references: [id])
  client    Client?    @relation(fields: [client_id], references: [id])
  warehouse Warehouse? @relation(fields: [warehouse_id], references: [id])

  @@index([company_id])
  @@index([client_id])
  @@index([pickup_id])
}

model SupportTicket {
  id           String   @id @default(uuid())
  company_id   String
  client_id    String?
  ticket_id    String   @unique
  awb_number   String?
  raised_by    String
  category     String
  sub_category String?
  description  String
  status       String   @default("Open") // Open, Resolved, Closed
  priority     String   @default("Medium") // High, Medium, Low
  last_update  DateTime @default(now())
  cc_emails    String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  client  Client? @relation(fields: [client_id], references: [id])

  @@index([company_id])
  @@index([client_id])
  @@index([ticket_id])
}

model ApiLog {
  id              String    @id @default(uuid())
  company_id      String
  courier_id      String?
  shipment_id     String?
  operation       String    // BOOKING, TRACKING, PICKUP, SERVICEABILITY, NDR, CANCEL
  request_time    DateTime  @default(now())
  response_time   DateTime?
  http_status     Int?
  success         Boolean   @default(true)
  error_code      String?
  request_meta    String?   // Sanitized JSON
  response_meta   String?   // Sanitized JSON
  retry_count     Int       @default(0)
  correlation_id  String?

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([shipment_id])
  @@index([operation])
}

model CourierAccount {
  id              String   @id @default(uuid())
  company_id      String
  courier_id      String
  account_name    String
  account_number  String?
  api_credentials String   // JSON string of keys/secrets
  is_default      Boolean  @default(false)
  status          String   @default("ACTIVE")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  courier CourierPartner @relation(fields: [courier_id], references: [id])

  @@index([company_id])
  @@index([courier_id])
}

model CourierWaybill {
  id                 String    @id @default(uuid())
  company_id         String
  courier_account_id String?
  courier_id         String
  waybill            String    @unique
  status             String    @default("AVAILABLE") // AVAILABLE, RESERVED, USED, INVALID, EXPIRED
  shipment_id        String?
  fetched_at         DateTime  @default(now())
  reserved_at        DateTime?
  used_at            DateTime?
  invalidated_at     DateTime?
  correlation_id     String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  courier CourierPartner @relation(fields: [courier_id], references: [id])

  @@unique([company_id, waybill])
  @@index([company_id, courier_id, status])
  @@index([waybill])
}
