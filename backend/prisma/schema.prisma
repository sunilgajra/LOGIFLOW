generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             String   @id @default(uuid())
  name           String
  branding_logo  String?
  address        String?
  gst_number     String?
  pan_number     String?
  invoice_prefix String?
  currency       String   @default("INR")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  users            User[]
  clients          Client[]
  courier_partners CourierPartner[]
  shipments        Shipment[]
  import_profiles  ImportProfile[]
  import_jobs      ImportJob[]
  rate_cards       RateCard[]
  invoices         ClientInvoice[]
  courier_bills    CourierBill[]
  audit_logs       AuditLog[]
  settings         Setting[]
  zoneMappings     ZoneMapping[]
  warehouses       Warehouse[]
  pickup_requests  PickupRequest[]
  support_tickets  SupportTicket[]
  api_logs         ApiLog[]
  courier_accounts CourierAccount[]
  courier_waybills CourierWaybill[]
  tracking_events  TrackingEvent[]
  ndr_records      NdrRecord[]
  client_rate_cards     ClientRateCard[]
  courier_rate_cards    CourierRateCard[]
  pincode_zone_mappings PincodeZoneMapping[]
  courier_invoices      CourierInvoice[]
  commercial_audit_logs CommercialAuditLog[]
}

model User {
  id                    String    @id @default(uuid())
  company_id            String
  email                 String    @unique
  password              String?
  first_name            String?
  last_name             String?
  role                  String    @default("VIEWER") // SUPER_ADMIN, ADMIN, OPERATIONS, ACCOUNTS, VIEWER, CLIENT
  client_id             String?
  reset_password_token  String?
  reset_password_expires DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  client  Client? @relation(fields: [client_id], references: [id])
}

model Client {
  id               String   @id @default(uuid())
  company_id       String
  client_id        String // Custom ID like CLI-001
  company_name     String
  contact_person   String?
  phone            String?
  email            String?
  address          String?
  gst_number       String?
  pan_number       String?
  billing_address  String?
  shipping_address String?
  payment_terms    String?
  credit_limit     Float?
  status           String   @default("ACTIVE")
  notes            String?
  agreement_document String? // Base64 string for PDF/Image
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  company          Company          @relation(fields: [company_id], references: [id])
  shipments        Shipment[]
  invoices         ClientInvoice[]
  rateCards        RateCard[]
  users            User[]
  warehouses       Warehouse[]
  pickup_requests  PickupRequest[]
  support_tickets  SupportTicket[]
  client_rate_cards ClientRateCard[]
}

model CourierPartner {
  id             String   @id @default(uuid())
  company_id     String
  courier_id     String // Custom ID
  courier_name   String
  contact_person String?
  phone          String?
  email          String?
  account_number String?
  billing_cycle  String?
  gst_number     String?
  status         String   @default("ACTIVE")
  notes          String?
  api_credentials     String? // JSON string containing API keys/secrets
  agreement_document  String? // Base64 string for PDF/Image
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  company         Company         @relation(fields: [company_id], references: [id])
  shipments       Shipment[]
  import_profiles ImportProfile[]
  rateCards       RateCard[]
  courier_bills   CourierBill[]
  accounts        CourierAccount[]
  courier_waybills CourierWaybill[]
  pickup_requests  PickupRequest[]
  courier_rate_cards CourierRateCard[]
  courier_invoices   CourierInvoice[]
}

model Shipment {
  id            String    @id @default(uuid())
  company_id    String
  awb_number    String
  client_id     String?
  courier_id    String?
  booking_date  DateTime?
  pickup_date   DateTime?
  delivery_date DateTime?

  sender_name      String?
  sender_phone     String?
  sender_address   String?
  receiver_name    String?
  receiver_phone   String?
  receiver_address String?
  city             String?
  state            String?
  pincode          String?
  origin           String?
  destination      String?

  service_type      String?
  package_type      String?
  number_of_pieces  Int?
  actual_weight     Decimal?  @db.Decimal(12, 4)
  volumetric_weight Decimal?  @db.Decimal(12, 4)
  chargeable_weight Decimal?  @db.Decimal(12, 4)

  cod_amount     Decimal?  @db.Decimal(12, 2)
  declared_value Decimal?  @db.Decimal(12, 2)

  courier_status   String? // Raw status from courier
  internal_status  String  @default("BOOKED") // Normalized status
  delivery_attempt Int     @default(0)
  rto_reason       String?
  exception_reason String?

  courier_cost  Decimal?  @db.Decimal(12, 2)
  client_charge Decimal?  @db.Decimal(12, 2) // Base freight + docket + fov
  profit        Decimal?  @db.Decimal(12, 2)
  remarks       String?

  client_reference_no String? // e.g. Inv No. from client
  green_tax_amount    Decimal   @default(0) @db.Decimal(12, 2)
  oda_amount          Decimal   @default(0) @db.Decimal(12, 2)
  fsc_amount          Decimal   @default(0) @db.Decimal(12, 2)
  idc_amount          Decimal   @default(0) @db.Decimal(12, 2)

  // --- Client Commercial Rate Snapshot (Frozen at Booking) ---
  client_base_freight  Decimal?   @default(0) @db.Decimal(12, 2)
  client_docket_charge Decimal?   @default(0) @db.Decimal(12, 2)
  client_fov_charge    Decimal?   @default(0) @db.Decimal(12, 2)
  client_fsc_amount    Decimal?   @default(0) @db.Decimal(12, 2)
  client_idc_amount    Decimal?   @default(0) @db.Decimal(12, 2)
  client_oda_amount    Decimal?   @default(0) @db.Decimal(12, 2)
  client_green_tax     Decimal?   @default(0) @db.Decimal(12, 2)
  client_gst_amount    Decimal?   @default(0) @db.Decimal(12, 2)
  client_total_charge  Decimal?   @default(0) @db.Decimal(12, 2)

  // --- Courier Purchase Cost Snapshot (Frozen at Booking) ---
  courier_base_cost    Decimal?   @default(0) @db.Decimal(12, 2)
  courier_docket_cost  Decimal?   @default(0) @db.Decimal(12, 2)
  courier_fov_cost     Decimal?   @default(0) @db.Decimal(12, 2)
  courier_fsc_cost     Decimal?   @default(0) @db.Decimal(12, 2)
  courier_idc_cost     Decimal?   @default(0) @db.Decimal(12, 2)
  courier_oda_cost     Decimal?   @default(0) @db.Decimal(12, 2)
  courier_green_tax    Decimal?   @default(0) @db.Decimal(12, 2)
  courier_gst_amount   Decimal?   @default(0) @db.Decimal(12, 2)
  courier_total_cost   Decimal?   @default(0) @db.Decimal(12, 2)

  // --- Package Dimensions & Volumetric Metrics ---
  length_cm            Float?
  width_cm             Float?
  height_cm            Float?

  // --- Detailed Courier Cost Breakdown & Commercial Charges ---
  forward_courier_cost Decimal?   @default(0) @db.Decimal(12, 2)
  ndr_charge           Decimal?   @default(0) @db.Decimal(12, 2)
  rto_charge           Decimal?   @default(0) @db.Decimal(12, 2)
  return_shipping_cost Decimal?   @default(0) @db.Decimal(12, 2)
  other_courier_cost   Decimal?   @default(0) @db.Decimal(12, 2)

  // --- Expected vs Actual Invoice Reconciliation & True Profit Metrics ---
  expected_courier_cost Decimal?  @default(0) @db.Decimal(12, 2)
  actual_courier_cost   Decimal?  @default(0) @db.Decimal(12, 2)
  cost_variance         Decimal?  @default(0) @db.Decimal(12, 2)
  variance_reason       String? // WEIGHT_DIFFERENCE, ZONE_DIFFERENCE, FUEL_SURCHARGE, COD_DIFFERENCE, NDR, RTO, REMOTE_AREA, OTHER, UNMATCHED
  estimated_profit      Decimal?  @default(0) @db.Decimal(12, 2)
  actual_profit         Decimal?  @default(0) @db.Decimal(12, 2)
  gross_margin          Decimal?  @default(0) @db.Decimal(12, 2)
  margin_percentage     Decimal?  @default(0) @db.Decimal(12, 2)

  // --- Frozen Rate Card Versioning Snapshot ---
  client_rate_card_id   String?
  courier_rate_card_id  String?
  rate_card_version     String?

  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  podImageUrl  String?
  podSignature String?
  deliveredAt  DateTime?
  label_url    String? // URL to the shipping label PDF from Courier
  ndr_records            NdrRecord[]
  commercial_audit_logs  CommercialAuditLog[]
  courier_invoice_lines  CourierInvoiceLine[]

  // --- Delhivery & Courier Gateway Booking Lifecycle & Idempotency ---
  delhivery_awb           String?
  delhivery_order_id      String?
  courier_account_id      String?
  booking_status          String    @default("NOT_BOOKED") // NOT_BOOKED, BOOKING_IN_PROGRESS, BOOKED, FAILED
  booking_attempts        Int       @default(0)
  last_booking_error      String?
  last_booking_attempt_at DateTime?
  booked_at               DateTime?
  correlation_id          String?

  pickup_request_id String?
  pickup_request    PickupRequest? @relation(fields: [pickup_request_id], references: [id])

  company Company         @relation(fields: [company_id], references: [id])
  client  Client?         @relation(fields: [client_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])

  appointment_date       DateTime?
  appointment_slot       String?
  appointment_token      String?
  dock_number            String?
  appointment_status     String?   @default("NOT_REQUIRED") // NOT_REQUIRED, SCHEDULED, CONFIRMED, COMPLETED, MISSED, RESCHEDULED
  appointment_notes      String?
  po_number              String?
  po_expiry_date         DateTime?
  promised_delivery_date DateTime?

  last_status_event_time DateTime?
  tracking_events        TrackingEvent[]

  invoice_id     String?
  invoice        ClientInvoice?          @relation(fields: [invoice_id], references: [id])
  status_history ShipmentStatusHistory[]

  @@unique([company_id, awb_number])
  @@index([awb_number])
  @@index([client_id])
  @@index([courier_id])
  @@index([internal_status])
  @@index([pincode])
}

model ShipmentStatusHistory {
  id          String   @id @default(uuid())
  shipment_id String
  status      String
  raw_status  String?
  location    String?
  timestamp   DateTime
  created_at  DateTime @default(now())

  shipment Shipment @relation(fields: [shipment_id], references: [id])
}

model TrackingEvent {
  id                 String   @id @default(uuid())
  shipment_id        String
  company_id         String
  courier_account_id String?
  awb                String
  courier_status     String
  internal_status    String
  event_time         DateTime
  location           String?
  description        String?
  raw_status         String?
  correlation_id     String?
  created_at         DateTime @default(now())

  shipment Shipment @relation(fields: [shipment_id], references: [id])
  company  Company  @relation(fields: [company_id], references: [id])

  @@unique([shipment_id, awb, courier_status, event_time, location])
  @@index([company_id])
  @@index([shipment_id])
  @@index([awb])
  @@index([event_time])
}

model ImportProfile {
  id           String   @id @default(uuid())
  company_id   String
  courier_id   String?
  name         String
  mapping_json String // JSON string of mappings
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company         @relation(fields: [company_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])
}

model ImportJob {
  id            String   @id @default(uuid())
  company_id    String
  file_name     String
  courier_id    String?
  status        String // PENDING, PROCESSING, COMPLETED, FAILED
  total_rows    Int      @default(0)
  imported_rows Int      @default(0)
  updated_rows  Int      @default(0)
  error_rows    Int      @default(0)
  created_by    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])
}

model RateCard {
  id         String @id @default(uuid())
  company_id String
  name       String
  type       String // CLIENT, COURIER

  min_weight_kg      Float @default(0)
  docket_charge      Float @default(0)
  min_booking_amount Float @default(0)
  volumetric_divisor Float @default(5000)
  fov_percentage     Float @default(0)
  fov_minimum        Float @default(0)

  fsc_percentage     Float @default(0)
  idc_percentage     Float @default(0)
  oda_charge         Float @default(0) // flat fee per shipment if applicable
  green_tax_rate     Float @default(0) // flat fee per shipment

  rates_matrix String @default("{}") // JSON string of origin-to-destination zones

  client_id  String?
  courier_id String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company         @relation(fields: [company_id], references: [id])
  client  Client?         @relation(fields: [client_id], references: [id])
  courier CourierPartner? @relation(fields: [courier_id], references: [id])
}

model ZoneMapping {
  id         String @id @default(uuid())
  company_id String
  state_name String
  zone_name  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, state_name])
}

model ClientInvoice {
  id             String   @id @default(uuid())
  company_id     String
  invoice_number String
  client_id      String
  invoice_date   DateTime
  due_date       DateTime
  shipment_count Int      @default(0)
  subtotal       Float    @default(0)
  total_fsc      Float    @default(0)
  total_idc      Float    @default(0)
  total_oda      Float    @default(0)
  total_green_tax Float   @default(0)
  
  off_loading_charges Float @default(0)
  vehicle_charges     Float @default(0)
  insurance_charges   Float @default(0)
  rto_charges         Float @default(0)

  taxable_amount Float    @default(0)
  cgst_amount    Float    @default(0)
  sgst_amount    Float    @default(0)
  igst_amount    Float    @default(0)
  round_off      Float    @default(0)

  discount       Float    @default(0)
  total_amount   Float    @default(0)
  paid_amount    Float    @default(0)
  status         String   @default("DRAFT") // DRAFT, SENT, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  company   Company    @relation(fields: [company_id], references: [id])
  client    Client     @relation(fields: [client_id], references: [id])
  shipments Shipment[]
}

model CourierBill {
  id           String   @id @default(uuid())
  company_id   String
  bill_number  String
  courier_id   String
  bill_date    DateTime
  total_amount Float
  status       String   @default("SUBMITTED") // SUBMITTED, RECONCILED, DISPUTED, PAID
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company           @relation(fields: [company_id], references: [id])
  courier CourierPartner    @relation(fields: [courier_id], references: [id])
  items   CourierBillItem[]
}

model CourierBillItem {
  id                   String   @id @default(uuid())
  courier_bill_id      String
  awb_number           String
  expected_weight      Float?
  billed_weight        Float?
  weight_discrepancy   Float?
  expected_zone        String?
  billed_zone          String?
  expected_cost        Float?
  billed_cost          Float?
  cost_variance        Float?
  reconciliation_status String  @default("MATCHED") // MATCHED, WEIGHT_DISCREPANCY, ZONE_MISMATCH, OVERCHARGED, UNMATCHED_AWB
  created_at           DateTime @default(now())

  courier_bill CourierBill @relation(fields: [courier_bill_id], references: [id], onDelete: Cascade)

  @@index([courier_bill_id])
  @@index([awb_number])
}

model AuditLog {
  id          String   @id @default(uuid())
  company_id  String
  user_id     String?
  action      String
  entity_type String?
  entity_id   String?
  details     String? // JSON string
  created_at  DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id])
}

model Setting {
  id         String   @id @default(uuid())
  company_id String
  key        String
  value      String // JSON string
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, key])
}

model Warehouse {
  id                    String   @id @default(uuid())
  company_id            String
  client_id             String?
  facility_name         String
  contact_person        String?
  contact_phone         String
  email                 String?
  address_line          String
  pincode               String
  city                  String
  state                 String
  default_pickup_slot   String?  @default("10:00 AM - 01:00 PM")
  working_days          String?  @default("Monday,Tuesday,Wednesday,Thursday,Friday,Saturday")
  return_same_as_pickup Boolean  @default(true)
  return_address        String?
  status                String   @default("ACTIVE")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  company         Company         @relation(fields: [company_id], references: [id])
  client          Client?         @relation(fields: [client_id], references: [id])
  pickup_requests PickupRequest[]

  @@index([company_id])
  @@index([client_id])
}

model PickupRequest {
  id                     String   @id @default(uuid())
  company_id             String
  client_id              String?
  courier_id             String?
  courier_account_id     String?
  pickup_id              String   @unique
  warehouse_id           String?
  facility_name          String
  pickup_location_name   String?
  pickup_date            DateTime
  pickup_slot            String
  pickup_time            String?  @default("14:00:00")
  box_count              Int      @default(1)
  expected_package_count Int      @default(1)
  lrn_numbers            String?
  pickup_reference       String?
  status                 String   @default("Scheduled") // Scheduled, Out for Pickup, Picked, Not Picked, Cancelled
  booking_status         String   @default("NOT_REQUESTED") // NOT_REQUESTED, SCHEDULING_IN_PROGRESS, SCHEDULED, FAILED
  last_pickup_error      String?
  correlation_id         String?
  escalated              Boolean  @default(false)
  otp_verified           Boolean  @default(false)
  executive_phone        String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  company   Company         @relation(fields: [company_id], references: [id])
  client    Client?         @relation(fields: [client_id], references: [id])
  warehouse Warehouse?      @relation(fields: [warehouse_id], references: [id])
  courier   CourierPartner? @relation(fields: [courier_id], references: [id])
  shipments Shipment[]

  @@unique([company_id, facility_name, pickup_date])
  @@index([company_id])
  @@index([client_id])
  @@index([courier_id])
  @@index([pickup_id])
}

model SupportTicket {
  id           String   @id @default(uuid())
  company_id   String
  client_id    String?
  ticket_id    String   @unique
  awb_number   String?
  raised_by    String
  category     String
  sub_category String?
  description  String
  status       String   @default("Open") // Open, Resolved, Closed
  priority     String   @default("Medium") // High, Medium, Low
  last_update  DateTime @default(now())
  cc_emails    String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])
  client  Client? @relation(fields: [client_id], references: [id])

  @@index([company_id])
  @@index([client_id])
  @@index([ticket_id])
}

model ApiLog {
  id              String    @id @default(uuid())
  company_id      String
  courier_id      String?
  shipment_id     String?
  operation       String    // BOOKING, TRACKING, PICKUP, SERVICEABILITY, NDR, CANCEL
  request_time    DateTime  @default(now())
  response_time   DateTime?
  http_status     Int?
  success         Boolean   @default(true)
  error_code      String?
  request_meta    String?   // Sanitized JSON
  response_meta   String?   // Sanitized JSON
  retry_count     Int       @default(0)
  correlation_id  String?

  company Company @relation(fields: [company_id], references: [id])

  @@index([company_id])
  @@index([shipment_id])
  @@index([operation])
}

model CourierAccount {
  id              String   @id @default(uuid())
  company_id      String
  courier_id      String
  account_name    String
  account_number  String?
  api_credentials String   // JSON string of keys/secrets
  is_default      Boolean  @default(false)
  status          String   @default("ACTIVE")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  courier CourierPartner @relation(fields: [courier_id], references: [id])

  @@index([company_id])
  @@index([courier_id])
}

model CourierWaybill {
  id                 String    @id @default(uuid())
  company_id         String
  courier_account_id String?
  courier_id         String
  waybill            String
  status             String    @default("AVAILABLE") // AVAILABLE, RESERVED, USED, FAILED_PENDING_REVIEW, INVALID, EXPIRED
  shipment_id        String?
  fetched_at         DateTime  @default(now())
  reserved_at        DateTime?
  used_at            DateTime?
  invalidated_at     DateTime?
  correlation_id     String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  company Company        @relation(fields: [company_id], references: [id])
  courier CourierPartner @relation(fields: [courier_id], references: [id])

  @@unique([company_id, courier_id, waybill])
  @@index([company_id, courier_id, status])
  @@index([waybill])
}

model NdrRecord {
  id                        String    @id @default(uuid())
  company_id                String
  shipment_id               String
  courier_id                String?
  courier_account_id        String?
  awb                       String
  ndr_code                  String?
  ndr_reason                String
  ndr_status                String    @default("NDR_RECEIVED") // NDR_RECEIVED, ACTION_REQUIRED, ACTION_SUBMITTED, ACTION_CONFIRMED, ACTION_FAILED
  attempt_number            Int       @default(1)
  event_time                DateTime
  selected_action           String?   // REATTEMPT, RTO, UPDATE_ADDRESS, UPDATE_PHONE
  action_status             String?   @default("PENDING") // PENDING, SUBMITTED, CONFIRMED, FAILED
  action_requested_at       DateTime?
  action_completed_at       DateTime?
  action_remarks            String?
  new_consignee_phone       String?
  new_consignee_address     String?
  scheduled_reattempt_date  DateTime?
  correlation_id            String?
  raw_delhivery_status      String?
  internal_normalized_status String?  @default("NDR")
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  company  Company  @relation(fields: [company_id], references: [id])
  shipment Shipment @relation(fields: [shipment_id], references: [id])

  @@unique([shipment_id, attempt_number, event_time])
  @@index([company_id])
  @@index([shipment_id])
  @@index([awb])
  @@index([ndr_status])
}

model ClientRateCard {
  id                 String           @id @default(uuid())
  company_id         String
  client_id          String
  name               String
  version            String           @default("1.0")
  effective_from     DateTime
  effective_to       DateTime?
  active             Boolean          @default(true)
  volumetric_divisor Float            @default(5000)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  company Company          @relation(fields: [company_id], references: [id])
  client  Client           @relation(fields: [client_id], references: [id])
  rules   ClientRateRule[]

  @@index([company_id])
  @@index([client_id])
}

model ClientRateRule {
  id                    String         @id @default(uuid())
  rate_card_id          String
  company_id            String
  zone                  String         // Zone A, Zone B, Zone C, Zone D, Zone E, Special
  service_type          String         @default("SURFACE") // SURFACE, EXPRESS
  min_weight_g          Decimal        @default(0) @db.Decimal(12, 4)
  max_weight_g          Decimal        @default(500) @db.Decimal(12, 4)
  base_rate             Decimal        @default(0) @db.Decimal(12, 2)
  additional_weight_g   Decimal        @default(500) @db.Decimal(12, 4)
  additional_rate       Decimal        @default(0) @db.Decimal(12, 2)
  cod_percentage        Decimal        @default(0) @db.Decimal(12, 2)
  cod_min_fee           Decimal        @default(0) @db.Decimal(12, 2)
  fuel_surcharge_pct    Decimal        @default(0) @db.Decimal(12, 2)
  handling_fee          Decimal        @default(0) @db.Decimal(12, 2)
  remote_area_fee       Decimal        @default(0) @db.Decimal(12, 2)
  other_surcharge       Decimal        @default(0) @db.Decimal(12, 2)
  gst_rate_pct          Decimal        @default(18) @db.Decimal(12, 2)
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  rate_card ClientRateCard @relation(fields: [rate_card_id], references: [id], onDelete: Cascade)

  @@index([rate_card_id])
  @@index([company_id])
}

model CourierRateCard {
  id                 String            @id @default(uuid())
  company_id         String
  courier_id         String            // DELHIVERY, BLUEDART
  courier_account_id String?
  name               String
  version            String            @default("1.0")
  effective_from     DateTime
  effective_to       DateTime?
  active             Boolean           @default(true)
  volumetric_divisor Float             @default(5000)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  company Company           @relation(fields: [company_id], references: [id])
  courier CourierPartner    @relation(fields: [courier_id], references: [id])
  rules   CourierRateRule[]

  @@index([company_id])
  @@index([courier_id])
}

model CourierRateRule {
  id                     String          @id @default(uuid())
  rate_card_id           String
  company_id             String
  zone                   String
  service_type           String          @default("SURFACE")
  min_weight_g           Decimal         @default(0) @db.Decimal(12, 4)
  max_weight_g           Decimal         @default(500) @db.Decimal(12, 4)
  base_cost              Decimal         @default(0) @db.Decimal(12, 2)
  additional_weight_g    Decimal         @default(500) @db.Decimal(12, 4)
  additional_cost        Decimal         @default(0) @db.Decimal(12, 2)
  cod_fee                Decimal         @default(0) @db.Decimal(12, 2)
  fuel_surcharge_pct     Decimal         @default(0) @db.Decimal(12, 2)
  rto_charge             Decimal         @default(0) @db.Decimal(12, 2)
  ndr_charge             Decimal         @default(0) @db.Decimal(12, 2)
  return_shipping_charge Decimal         @default(0) @db.Decimal(12, 2)
  remote_area_charge     Decimal         @default(0) @db.Decimal(12, 2)
  other_charge           Decimal         @default(0) @db.Decimal(12, 2)
  gst_rate_pct           Decimal         @default(18) @db.Decimal(12, 2)
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt

  rate_card CourierRateCard @relation(fields: [rate_card_id], references: [id], onDelete: Cascade)

  @@index([rate_card_id])
  @@index([company_id])
}

model PincodeZoneMapping {
  id         String   @id @default(uuid())
  company_id String
  pincode    String
  zone       String   // Zone A, Zone B, Zone C, etc.
  courier_id String?
  client_id  String?
  city       String?
  state      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  company Company @relation(fields: [company_id], references: [id])

  @@unique([company_id, pincode, courier_id, client_id])
  @@index([company_id])
  @@index([pincode])
}

model CourierInvoice {
  id                 String               @id @default(uuid())
  company_id         String
  courier_id         String
  courier_account_id String?
  invoice_number     String
  invoice_date       DateTime
  total_amount       Decimal              @default(0) @db.Decimal(12, 2)
  status             String               @default("UNRECONCILED") // UNRECONCILED, PARTIALLY_RECONCILED, RECONCILED, DISPUTED
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt

  company Company              @relation(fields: [company_id], references: [id])
  courier CourierPartner       @relation(fields: [courier_id], references: [id])
  lines   CourierInvoiceLine[]

  @@unique([company_id, courier_id, invoice_number])
  @@index([company_id])
  @@index([invoice_number])
}

model CourierInvoiceLine {
  id                 String         @id @default(uuid())
  invoice_id         String
  company_id         String
  awb_number         String
  shipment_id        String?
  charged_weight     Decimal        @default(0) @db.Decimal(12, 4)
  zone               String?
  base_freight       Decimal        @default(0) @db.Decimal(12, 2)
  fuel_surcharge     Decimal        @default(0) @db.Decimal(12, 2)
  cod_fee            Decimal        @default(0) @db.Decimal(12, 2)
  ndr_fee            Decimal        @default(0) @db.Decimal(12, 2)
  rto_fee            Decimal        @default(0) @db.Decimal(12, 2)
  return_charge      Decimal        @default(0) @db.Decimal(12, 2)
  other_charge       Decimal        @default(0) @db.Decimal(12, 2)
  gst_amount         Decimal        @default(0) @db.Decimal(12, 2)
  total_amount       Decimal        @default(0) @db.Decimal(12, 2)
  expected_cost      Decimal        @default(0) @db.Decimal(12, 2)
  cost_variance      Decimal        @default(0) @db.Decimal(12, 2)
  variance_reason    String         @default("UNMATCHED") // WEIGHT_DIFFERENCE, ZONE_DIFFERENCE, FUEL_SURCHARGE, COD_DIFFERENCE, NDR, RTO, REMOTE_AREA, OTHER, UNMATCHED, MATCHED
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  invoice  CourierInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  shipment Shipment?       @relation(fields: [shipment_id], references: [id])

  @@unique([invoice_id, awb_number])
  @@index([invoice_id])
  @@index([company_id])
  @@index([awb_number])
  @@index([shipment_id])
}

model CommercialAuditLog {
  id               String    @id @default(uuid())
  company_id       String
  shipment_id      String?
  awb_number       String?
  calculation_type String    // CLIENT_ESTIMATE, COURIER_ESTIMATE, INVOICE_RECONCILIATION
  rate_card_id     String?
  rate_card_name   String?
  rate_card_version String?
  chargeable_weight Decimal?  @db.Decimal(12, 4)
  zone             String?
  breakdown_json   String?   // JSON string of rate breakdown
  correlation_id   String?
  created_at       DateTime  @default(now())

  company  Company   @relation(fields: [company_id], references: [id])
  shipment Shipment? @relation(fields: [shipment_id], references: [id])

  @@index([company_id])
  @@index([shipment_id])
  @@index([awb_number])
}
